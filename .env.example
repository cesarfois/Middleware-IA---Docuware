# ============================================================================
# UNIVERSAL DOCUMENT AI GATEWAY (DOCUWARE CLOUD 7.14 <-> MULTI-PROVIDER AI)
# ============================================================================

# Porta de escuta HTTP do container/serviço
PORT=3014
HOST=0.0.0.0
NODE_ENV=production

# Token secreto para autenticação das requisições vindas do DocuWare Cloud
# Aceito via Header: "X-DocuWare-Token: <API_AUTH_TOKEN>" ou "Authorization: Bearer <API_AUTH_TOKEN>"
API_AUTH_TOKEN=docuware_token_2026

# Provedor Padrão: OpenAI
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2

# Provedores Adicionais Opcionais (Credenciais permanecem protegidas no servidor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=gpt-4o

# Limite máximo do arquivo PDF em bytes (Padrão: 30 MB = 31457280 bytes)
MAX_FILE_SIZE=31457280
