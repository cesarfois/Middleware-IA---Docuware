# ============================================================================
# GATEWAY UNIVERSAL DE IA DOCUMENTAL (DOCUWARE CLOUD 7.14 <-> OPENAI GPT-4o)
# ============================================================================

# Porta de escuta HTTP do container/serviço
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Token secreto para autenticação das requisições vindas do DocuWare Cloud
# Aceito via Header: "X-DocuWare-Token: <API_AUTH_TOKEN>" ou "Authorization: Bearer <API_AUTH_TOKEN>"
API_AUTH_TOKEN=dw_prod_secret_token_change_me_9f8a7b6c5d4e3f2a1b

# Configurações da OpenAI
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2

# Limite máximo do arquivo PDF em bytes (Padrão: 30 MB = 31457280 bytes)
MAX_FILE_SIZE=31457280

